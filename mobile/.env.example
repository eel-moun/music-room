# Copy to mobile/.env (gitignored). EXPO_PUBLIC_* values are bundled into the app:
# they are public by design, never put a secret here.

# Default backend address (the PC's LAN IP); changeable in the app's Settings screen.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Google Sign-In (development build only). Web client id = the audience the backend checks.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: the reversed iOS client id, e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_IOS_URL_SCHEME=
