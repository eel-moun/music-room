# Copy to .env and fill in real values: cp .env.example .env
# For the production-like stack (docker-compose.prod.yml), also create .env.prod
# with different secrets and a real SMTP provider.
# .env and .env.prod are gitignored. Never commit real credentials.

# --- App ---
APP_ENV=development
API_PORT=8000
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=musicroom
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth (Day 2) ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# --- Email (mailpit in dev, UI on http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@musicroom.local

# --- Music provider: audius | jamendo ---
MUSIC_PROVIDER=audius
AUDIUS_API_KEY=
JAMENDO_CLIENT_ID=
