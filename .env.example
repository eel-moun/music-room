# Copy to .env and fill in real values: cp .env.example .env
# For the production-like stack (docker-compose.prod.yml), also create .env.prod
# with different secrets (JWT_SECRET: openssl rand -hex 32) and a real SMTP provider.
# .env and .env.prod are gitignored. Never commit real credentials.

# --- App ---
APP_ENV=development
API_PORT=8000
LOG_LEVEL=INFO
# Base of the links in emails. Use the PC's LAN IP so links open from a phone.
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated web origins allowed by CORS (empty: CORS off; the mobile app doesn't need it)
CORS_ORIGINS=

# --- PostgreSQL ---
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=musicroom
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Per uvicorn worker: keep workers x (pool + overflow) under Postgres max_connections (100)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Production refuses to start with a default or short secret (32+ characters).
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
EMAIL_TOKEN_TTL_SECONDS=86400
# Google Sign-In: OAuth client ids from Google Cloud Console. ID tokens are accepted only
# if their audience is one of these. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# --- Email (mailpit in dev, UI on http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@musicroom.local

# --- Music provider ---
MUSIC_PROVIDER=audius
AUDIUS_API_KEY=

# --- Observability (make obs-up) ---
GRAFANA_ADMIN_PASSWORD=change-me
